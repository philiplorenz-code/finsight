# Copy to .env; generate DIFFERENT random values with: openssl rand -hex 32
POSTGRES_PASSWORD=
FINSIGHT_BOOTSTRAP_SECRET=
APP_URL=http://localhost:8080
BIND_ADDRESS=127.0.0.1
PORT=8080
# Set true behind HTTPS. Local HTTP requires false.
FINSIGHT_COOKIE_SECURE=false
# Behind HTTPS, explicitly allow your exact canonical browser origin (JSON array).
# FINSIGHT_ALLOWED_ORIGINS=["https://finance.example.com"]
# Optional stable-file watcher; owner ID is available from /api/auth/me.
FINSIGHT_WATCH_IMPORTS=false
FINSIGHT_WATCH_OWNER_ID=
FINSIGHT_MAX_UPLOAD_BYTES=26214400
FINSIGHT_MAX_UNCOMPRESSED_BYTES=67108864
FINSIGHT_MAX_IMPORT_ROWS=100000

# Disabled by default: explicit external transmission consent also required.
AI_ENABLED=false
AI_EXTERNAL_CONSENT=false
AI_PROACTIVE_ENABLED=false
# Example (any OpenAI-compatible provider via LiteLLM), e.g. DeepSeek:
#   AI_PROVIDER_BASE_URL=https://api.deepseek.com  AI_MODEL=deepseek/deepseek-chat  AI_MODEL_ALLOWLIST=deepseek/deepseek-chat
#   AI_INPUT_EUR_PER_MILLION / AI_OUTPUT_EUR_PER_MILLION: your provider's price, a budget safeguard (use a rounded-up value).
AI_PROVIDER_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_MODEL_ALLOWLIST=
AI_MONTHLY_BUDGET_EUR=5.00
# Optional extra lifetime cap; absent defaults conservatively to the monthly cap.
# AI_TOTAL_BUDGET_EUR=60.00
AI_SCHEDULED_BUDGET_EUR=2.00
AI_CHAT_BUDGET_EUR=3.00
AI_MAX_RUN_COST_EUR=0.25
AI_MAX_INPUT_TOKENS=8000
AI_MAX_OUTPUT_TOKENS=2000
AI_MAX_AGENT_STEPS=8
AI_MAX_TOOL_CALLS=20
AI_MAX_RUNTIME_SECONDS=90
AI_MAX_CONCURRENT_RUNS=1
AI_RETRY_LIMIT=0
AI_INPUT_EUR_PER_MILLION=
AI_OUTPUT_EUR_PER_MILLION=
LANGFUSE_ENABLED=false
LITELLM_TELEMETRY=false
DO_NOT_TRACK=true
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false

# External assistants receive requested financial data after explicit OAuth consent.
# Internal AI and MCP are independent switches; public clients require HTTPS APP_URL.
MCP_ENABLED=false
# Optional comma-separated CIDRs of ONLY trusted immediate web proxies. Empty = no
# forwarding-header trust. The web proxy overwrites X-FinSight-Client-IP.
MCP_TRUSTED_PROXY_CIDRS=

NTFY_ENABLED=false
NTFY_SERVER_URL=https://ntfy.sh
NTFY_TOPIC=
NTFY_ACCESS_TOKEN=""
NTFY_REMINDER_DAYS=14
NTFY_REMINDER_TIME=09:00
NTFY_QUIET_START=22:00
NTFY_QUIET_END=08:00
